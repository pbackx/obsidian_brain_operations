filters:
  and:
    - file.ext == "md"
    - type == "task"
    - '!file.inFolder("Templates")'
formulas:
  card_cover: if(cover.isTruthy(), cover, if(status == "backlog", "", if(category == "home-automation", "#2a9d8f", if(category == "lego-ai", "#f4a261", if(category == "games", "#e76f51", if(category == "music", "#9b5de5", if(category == "language", "#e63946", if(category == "freewrite", "#6c757d", "#457b9d"))))))))
properties:
  status:
    displayName: Status
  category:
    displayName: Category
  priority:
    displayName: Priority
  updated:
    displayName: Updated
  created:
    displayName: Created
  summary:
    displayName: Latest AI Summary
  question:
    displayName: Pending Question
views:
  - type: kanban
    name: "📋 All Active Kanban"
    filters:
      and:
        - '!file.inFolder("TODO/Archive")'
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - backlog
      - ai-queue
      - needs-clarification
      - in-progress
      - completed
      - archived
    order:
      - file.name
      - category
      - priority
      - updated
  - type: kanban
    name: "🤖 AI Workflow Board"
    filters:
      and:
        - '!file.inFolder("TODO/Archive")'
        - or:
            - status == "ai-queue"
            - status == "needs-clarification"
            - summary.isTruthy()
            - status == "archived"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - ai-queue
      - needs-clarification
      - in-progress
      - completed
      - archived
    order:
      - file.name
      - category
      - updated
      - question
    image: formula.card_cover
    imageAspectRatio: 0.25
  - type: table
    name: "❓ Needs My Input"
    filters:
      and:
        - status == "needs-clarification"
    order:
      - file.name
      - category
      - question
      - summary
      - updated
  - type: table
    name: "📦 Archive"
    filters:
      or:
        - status == "archived"
        - file.inFolder("TODO/Archive")
    order:
      - file.name
      - category
      - updated
      - summary

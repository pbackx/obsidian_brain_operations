# Copy to artframe.env (git-ignored) and fill in.
OPENROUTER_API_KEY=
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_DEVICE_ID=

# --- Frame geometry (the COMPOSITION as it hangs on the wall) ---------------------------
# 7.3"  AI Art Frame, landscape:      800 x 480   + FRAME_ROTATE=none  (verified 2026-11-23)
# 7.3"  AI Art Frame, portrait:       480 x 800   + FRAME_ROTATE=none
# 13.3" AI Art Frame, portrait (3:4): 1200 x 1600 + FRAME_ROTATE=none
# 31.5" AI Art Frame, landscape:      1600 x 1200 + FRAME_ROTATE=none (verify per model)
FRAME_WIDTH=800
FRAME_HEIGHT=480
# The panel buffer itself is portrait (480 x 800 on the 7.3" model), but the 7.3" firmware also
# accepts the un-rotated landscape composition and then renders it upright BOTH on the wall and in
# the SwitchBot app (its cloud preview shows the raw upload). Only set cw/ccw if a frame model
# really needs the legacy pre-rotated panel buffer; rotation is applied to the uploaded JPEG only,
# the gallery preview always stays landscape. none | cw | ccw
FRAME_ROTATE=none

ARTFRAME_MODEL=google/gemini-2.5-flash-image

# A full 10-image album rejects every upload with code=7301. Evicting the oldest artwork
# (the displayed one is never deleted) keeps unattended pushes working. Set to 0 to disable.
ARTFRAME_EVICT_FULL=1
ARTFRAME_EVICT_SELECTOR=oldest

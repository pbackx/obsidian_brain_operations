# Copy to artframe.env (git-ignored) and fill in.
OPENROUTER_API_KEY=
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_DEVICE_ID=

# --- Frame geometry (the COMPOSITION as it hangs on the wall) ---------------------------
# 7.3"  AI Art Frame, landscape:      800 x 480   + FRAME_ROTATE=cw
# 7.3"  AI Art Frame, portrait:       480 x 800   + FRAME_ROTATE=none
# 13.3" AI Art Frame, portrait (3:4): 1200 x 1600 + FRAME_ROTATE=none
# 31.5" AI Art Frame, landscape:      1600 x 1200 + FRAME_ROTATE=cw
FRAME_WIDTH=800
FRAME_HEIGHT=480
# The panel buffer itself is always portrait (480 x 800 on the 7.3" model). SwitchBot's own app
# stores landscape artwork rotated 90 degrees clockwise; FRAME_ROTATE replays that convention on
# the uploaded JPEG only (the UI preview stays landscape). none | cw | ccw
FRAME_ROTATE=cw

ARTFRAME_MODEL=google/gemini-2.5-flash-image

# A full 10-image album rejects every upload with code=7301. Evicting the oldest artwork
# (the displayed one is never deleted) keeps unattended pushes working. Set to 0 to disable.
ARTFRAME_EVICT_FULL=1
ARTFRAME_EVICT_SELECTOR=oldest

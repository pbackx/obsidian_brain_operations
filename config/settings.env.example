# Configuration for Antigravity Nightly Obsidian Operator
# Copy this file to config/settings.env and configure your paths.

# Path to the local Obsidian vault directory
VAULT_LOCAL="$HOME/vault_sync/ObsidianVault"

# Synchronization method: "obsidian-headless" | "rclone" | "none"
# "obsidian-headless": Uses official Obsidian Headless CLI (`ob sync`)
# "rclone": Uses rclone to sync with cloud drives (e.g. Google Drive)
# "none": Vault is managed/synced externally or local-only
SYNC_METHOD="obsidian-headless"

# (Only used if SYNC_METHOD="rclone")
VAULT_REMOTE=""
BACKUP_DIR="$HOME/vault_sync/backups"

# Maximum number of tasks to process per night
MAX_TASKS=3

# Reasoning effort for Antigravity session (low | medium | high | max)
EFFORT="high"

# Total time budget in seconds for all tasks combined (default: 3 hours = 10800s)
TIMEOUT_SECONDS=10800

# Maximum time in seconds allowed for any single task (default: 30 minutes = 1800s)
TASK_TIMEOUT=1800

# ------------------------------------------------------------------------------
# Quota-Aware Model Routing & Automatic Fallback (scripts/check_quota.py)
# ------------------------------------------------------------------------------
# Enable automatic pre-task quota checks and model fallback ("true" | "false")
QUOTA_AUTO_DOWNGRADE="true"

# Primary model when Gemini 4 Argon weekly quota is above reserve threshold
PRIMARY_MODEL="gemini-4-argon-high"

# Optional intermediate step-down: if > 0 and Argon weekly quota is below this %
# (but still >= ARGON_RESERVE_PCT), step down to gemini-4-argon-medium to save tokens
ARGON_MEDIUM_BELOW_PCT=0

# Minimum Gemini 4 Argon weekly quota (%) to keep in reserve for daytime interactive use.
# When Argon drops below this %, nightly tasks automatically downgrade to FALLBACK_MODELS.
ARGON_RESERVE_PCT=20

# Ordered comma-separated fallback chain across independent quota buckets:
# - Claude/GPT bucket (3p-weekly / 3p-5h): claude-opus-5-5-high, claude-sonnet-5-5-high, gpt-oss-120b-medium
# - Gemini Models bucket (gemini-weekly / gemini-5h): gemini-3.8-flash-high, gemini-3.8-flash-medium
FALLBACK_MODELS="claude-opus-5-5-high,gemini-3.8-flash-high,claude-sonnet-5-5-high,gemini-3.8-flash-medium"

# Minimum remaining quota (%) required in a fallback bucket (both 5h and weekly)
FALLBACK_MIN_PCT=5

# ------------------------------------------------------------------------------
# Optional Freewrite Smart Typewriter (Postbox -> Google Drive / NAS) Ingestion
# ------------------------------------------------------------------------------
# Set to "true" to automatically ingest Freewrite drafts before scanning for #ai tasks
FREEWRITE_ENABLED="false"

# Local directory or NAS mount containing Postbox drafts (A/, B/, C/)
FREEWRITE_SOURCE_DIR="$HOME/vault_sync/freewrite_postbox"

# Optional rclone remote path (e.g. "gdrive:Postbox") to pull from Google Drive before ingesting
FREEWRITE_RCLONE_REMOTE=""

# Target top-level folder inside the Obsidian vault for imported Freewrite notes
FREEWRITE_VAULT_SUBDIR="Freewrite"

# Optional comma-separated filter of Postbox folders to ingest (e.g. "A,B,C" or "C"; empty = all)
FREEWRITE_FOLDERS=""

# Optional comma-separated Postbox folders where every draft is automatically queued as an #ai task
# even if you didn't type "#ai" in the text (e.g. "C")
FREEWRITE_AI_FOLDERS=""


# Configuration for Antigravity Nightly Obsidian Operator
# Copy this file to config/settings.env and configure your paths.

# Path to the local Obsidian vault directory
VAULT_LOCAL="$HOME/vault_sync/ObsidianVault"

# Synchronization method: "obsidian-headless" | "rclone" | "none"
# "obsidian-headless": Uses official Obsidian Headless CLI (`ob sync`)
# "rclone": Uses rclone to sync with cloud drives (e.g. Google Drive)
# "none": Vault is managed/synced externally or local-only
SYNC_METHOD="obsidian-headless"

# (Only used if SYNC_METHOD="rclone")
VAULT_REMOTE=""
BACKUP_DIR="$HOME/vault_sync/backups"

# Maximum number of tasks to process per night
MAX_TASKS=3

# Reasoning effort for Antigravity session (low | medium | high | max)
EFFORT="high"

# Default CLI agent runner unless overridden by `runner:` in task frontmatter ("agy" | "pi")
AGENT_RUNNER="agy"

# Default OpenRouter model used when a task runs with `runner: pi` without specifying `model:`
PI_MODEL="openrouter/anthropic/claude-sonnet-latest"

# Optional default OpenRouter upstream provider slug(s) for `runner: pi` (e.g. "nebius" or "nebius,mistral")
# Overridden per task via `provider:` in frontmatter; leave empty for OpenRouter's default routing
PI_OPENROUTER_PROVIDER=""

# OpenRouter API key (uncomment and set in local config/settings.env or source from ~/.config/secrets/openrouter.env)
# OPENROUTER_API_KEY="sk-or-v1-..."

# Total time budget in seconds for all tasks combined (default: 3 hours = 10800s)
TIMEOUT_SECONDS=10800

# Default time in seconds allowed for a single task unless overridden by `timeout:` in frontmatter (default: 30m = 1800s)
TASK_TIMEOUT=1800

# Maximum time in seconds allowed for any single task even with a frontmatter `timeout:` override (default: 2h = 7200s)
MAX_TASK_TIMEOUT=7200

# Rolling window in days for Brain_Operations/00_Nightly_Log.md before rotating to yearly cold storage (default: 14 days)
LOG_RETENTION_DAYS=14

# ------------------------------------------------------------------------------
# Quota-Aware Model Routing & Automatic Fallback (scripts/check_quota.py)
# ------------------------------------------------------------------------------
# Enable automatic pre-task quota checks and model fallback ("true" | "false")
QUOTA_AUTO_DOWNGRADE="true"

# Primary model when Gemini Models effective quota (weekly & 5h) is above reserve threshold
# Gemini 4 lineup in `agy models`: gemini-4-neon-*, gemini-4-carbon-*, gemini-4-hydrogen-*
PRIMARY_MODEL="gemini-4-carbon-medium"

# Optional intermediate step-down: if > 0 and Gemini Models quota is below this %
# (but still >= GEMINI_RESERVE_PCT), step down to GEMINI_STEPDOWN_MODEL to save quota
GEMINI_STEPDOWN_BELOW_PCT=0
GEMINI_STEPDOWN_MODEL="gemini-4-hydrogen-medium"

# Minimum Gemini Models quota (%) to keep in reserve for daytime interactive use.
# When Gemini Models drops below this %, nightly tasks automatically route to FALLBACK_MODELS.
GEMINI_RESERVE_PCT=20

# Ordered comma-separated fallback chain across quota pools:
# - Claude/GPT pool (3p-weekly / 3p-5h): claude-opus-5-5-high, claude-sonnet-5-5-high, gpt-oss-120b-medium
# - Lighter Gemini Models (gemini-weekly / gemini-5h, used if 3p is also exhausted): gemini-4-hydrogen-medium, gemini-3.8-flash-medium
FALLBACK_MODELS="claude-opus-5-5-high,claude-sonnet-5-5-high,gemini-4-hydrogen-medium,gemini-3.8-flash-medium"

# Minimum remaining quota (%) required in a fallback bucket (both 5h and weekly)
FALLBACK_MIN_PCT=5

# ------------------------------------------------------------------------------
# Optional Freewrite Smart Typewriter (Postbox -> Google Drive / NAS) Ingestion
# ------------------------------------------------------------------------------
# Set to "true" to automatically ingest Freewrite drafts before scanning for #ai tasks
FREEWRITE_ENABLED="false"

# Local directory or NAS mount containing Postbox drafts (A/, B/, C/)
FREEWRITE_SOURCE_DIR="$HOME/vault_sync/freewrite_postbox"

# Optional rclone remote path (e.g. "gdrive:Postbox") to pull from Google Drive before ingesting
FREEWRITE_RCLONE_REMOTE=""

# Target top-level folder inside the Obsidian vault for imported Freewrite notes
FREEWRITE_VAULT_SUBDIR="Freewrite"

# Optional comma-separated filter of Postbox folders to ingest (e.g. "A,B,C" or "C"; empty = all)
FREEWRITE_FOLDERS=""

# Optional comma-separated Postbox folders where every draft is automatically queued as an #ai task
# even if you didn't type "#ai" in the text (e.g. "C")
FREEWRITE_AI_FOLDERS=""

# ------------------------------------------------------------------------------
# Portfolio Performance & Belgian Meerwaardebelasting (Optional)
# ------------------------------------------------------------------------------
# Password for encrypted .portfolio files (AES-256)
# PP_PASSWORD="your-portfolio-performance-password"
# Path to .portfolio file on local filesystem or mounted share
# PP_FILE_PATH="/mnt/media_library/PortfolioPerformance/PetersPortfolio.portfolio"


